name: Deploy GeoAlert to Streamlit Cloud

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      
      - name: Install dependencies
        run: |
          pip install -r requirements.txt
      
      - name: Lint check
        run: |
          pip install flake8
          flake8 agentic_dashboard.py --max-line-length=120

  deploy:
    needs: test
    if: github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: Deploy to Streamlit Cloud
        uses: streamlit/streamlit-app-action@v1
        with:
          app-file: agentic_dashboard.py
          requirements-file: requirements.txt
        env:
          STREAMLIT_CLOUD_API_KEY: ${{ secrets.STREAMLIT_CLOUD_API_KEY }}
